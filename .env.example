# --- Admin panel (/admin) ---
# Sign-in email for /admin (default: guehipoegnansergej@gmail.com). Can be changed later in Admin → Account.
ADMIN_EMAIL=guehipoegnansergej@gmail.com
# First password to sign in to /admin (12+ characters, use a long random passphrase).
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie (32+ random characters).
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# --- Content & media storage ---
# Created automatically when you connect a Vercel Blob store to the project
# (Vercel > Storage > Create > Blob > Connect to project).
BLOB_READ_WRITE_TOKEN=

# --- Booking emails (existing) ---
RESEND_API_KEY=
CONTACT_EMAIL=
